# Copy to .env.local; never commit credentials. Compose reads it with --env-file.
OPENAI_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
ALLOW_AUTOMATION_WRITES=false
ALLOW_BLUEPRINT_WRITES=false
ALLOW_MANAGEMENT_WRITES=false
# Optional InfluxDB read-only credentials (1.x or 2.x).
INFLUX_URL=
INFLUX_VERSION=1
INFLUX_DATABASE=homeassistant
INFLUX_USER=
INFLUX_PASSWORD=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=homeassistant
# YAML package editing requires a local mount; see compose.yaml and README.
HA_YAML_FILES=[]
HA_CONFIG_FILES=[]
# Blank uses HA_CONFIG_DIR/esphome. Override with an absolute container path.
# Mount the matching ESPHome configuration directory read-only; see compose.yaml.
ESPHOME_CONFIG_DIR=

# Optional isolated ESPHome worker (docker compose --env-file .env.local --profile esphome up -d --build).
ESPHOME_WORKER_URL=
ESPHOME_WORKER_TOKEN=
ALLOW_ESPHOME_CONFIG_WRITES=false
ALLOW_ESPHOME_INSTALL=false
